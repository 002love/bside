{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bside",
  "version": "0.5.0",
  "identifier": "io.github.002love.bside",
  "build": {
    "beforeBuildCommand": "npm --prefix web run build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Local-first Spotify listening & friend-circle analytics",
    "category": "Music"
  }
}
